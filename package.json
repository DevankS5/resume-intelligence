{
  "name": "resume-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first resume screening for two job profiles: LLM extraction, deterministic versioned scoring, HR review.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
