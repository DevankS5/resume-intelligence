      "html": "<span class=\"ds-rmark ds-human\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"currentColor\"/></svg>Verified</span> <span class=\"ds-rmark\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/></svg>Unreviewed</span> <span class=\"ds-stamp ds-fail\">Failed</span> <span class=\"ds-stamp ds-review\">Needs review</span>",
      "css": ".ds-rmark{display:inline-flex;align-items:center;gap:6px;padding:2px 6px;border-radius:var(--radius-chip,6px);font:600 12px/1.4 'Public Sans',system-ui,sans-serif;color:var(--color-ink-3)} .ds-human{background:var(--color-violet-soft);color:var(--color-violet-ink)} .ds-stamp{display:inline-block;padding:1px 6px;border:1.5px solid currentColor;border-radius:var(--radius-chip,6px);font:800 11px/1.4 'Public Sans',system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase} .ds-fail{color:var(--color-uncertain)} .ds-review{color:var(--color-related)}"
    },
