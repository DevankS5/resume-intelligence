      "html": "<div class=\"ds-score\"><span class=\"ds-score-n\">68</span><span class=\"ds-score-track\"><span class=\"ds-score-fill\" style=\"width:68%\"></span><i style=\"left:35%\"></i><i style=\"left:55%\"></i><i style=\"left:75%\"></i></span></div>",
      "css": ".ds-score{display:flex;align-items:center;gap:10px;font-family:'Public Sans',system-ui,sans-serif} .ds-score-n{width:44px;text-align:right;font-weight:700;font-size:15px;font-variant-numeric:tabular-nums;color:var(--color-ink)} .ds-score-track{position:relative;height:8px;width:96px;overflow:hidden;border-radius:9999px;background:var(--color-rule)} .ds-score-fill{position:absolute;top:0;bottom:0;left:0;border-radius:9999px;background:var(--color-ink)} .ds-score-track i{position:absolute;top:0;bottom:0;width:1px;background:var(--color-sheet)}"
    },
    {
      "name": "Record-Count Strip",
      "kind": "custom",
      "refersTo": "",
      "description": "The count that must reconcile, shown on every app screen.",
      "html": "<section class=\"ds-count\"><p><b>47</b> of 47 expected records accounted for</p><div class=\"ds-count-bar\"><span style=\"width:70%;background:var(--color-ink)\"></span><span style=\"width:21%;background:var(--color-related)\"></span><span style=\"width:9%;background:var(--color-uncertain)\"></span></div><ul><li><i style=\"background:var(--color-ink)\"></i>Scored <b>33</b></li><li><i style=\"background:var(--color-related)\"></i>Needs review <b>10</b></li><li><i style=\"background:var(--color-uncertain)\"></i>Failed <b>4</b></li></ul></section>",
      "css": ".ds-count{display:flex;flex-wrap:wrap;align-items:center;gap:8px 32px;padding:12px 20px;background:var(--color-sheet);border-bottom:1px solid var(--color-rule);font:400 13px/1.5 'Public Sans',system-ui,sans-serif;color:var(--color-ink-2);font-variant-numeric:tabular-nums} .ds-count p{margin:0} .ds-count b{color:var(--color-ink);font-weight:700} .ds-count-bar{display:flex;flex:1;min-width:220px;height:10px;overflow:hidden;border-radius:9999px;background:var(--color-rule)} .ds-count-bar span{height:100%;border-right:1px solid var(--color-sheet)} .ds-count ul{display:flex;gap:20px;margin:0;padding:0;list-style:none} .ds-count li{display:flex;align-items:center;gap:6px} .ds-count li i{width:10px;height:10px;border-radius:3px}"
    },
