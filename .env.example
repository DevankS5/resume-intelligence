# Copy to .env.local and fill in. Never commit real values (.env* is gitignored).

# --- Public (intentionally exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Used by the batch importer and the upload-processing route only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Structured-output extraction provider (see docs/ARCHITECTURE_DECISIONS.md ADR-009).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Fixed assessment date for "Present" roles so scores are reproducible (YYYY-MM).
ASSESSMENT_REFERENCE_MONTH=2026-11
