{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@domain/*": ["./packages/domain/*"],
      "@schemas/*": ["./packages/schemas/*"],
      "@parsers/*": ["./packages/parsers/*"],
      "@normalization/*": ["./packages/normalization/*"],
      "@extraction/*": ["./packages/extraction/*"],
      "@scoring/*": ["./packages/scoring/*"],
      "@workflows/*": ["./packages/workflows/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "Software Development Assignment Resumes"]
}
